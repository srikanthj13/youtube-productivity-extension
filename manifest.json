{
  "manifest_version": 3,
  "name": "YouTube Productivity Extension",
  "version": "1.0",
  "description": "Stay focused on YouTube with distraction blocking and smart tools",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}

